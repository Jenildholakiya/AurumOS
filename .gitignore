# ── AurumOS .gitignore ──────────────────────────────────────────

# Logs (runtime output)
logs/
*.log

# PyInstaller build output
build/
dist/
_internal/
pythonnet_runtime_backup*/
# AurumOS.spec is written from scratch by build.py on every run, and the paths
# inside it belong to whichever machine last built. Tracking it meant the
# committed copy pointed at a drive that does not exist here, and every build
# left a change that blocked the next merge.
AurumOS.spec
database/aurum_local.db
database/aurum_local.db-shm
database/aurum_local.db-wal
database/aurum_test_bastion.db
database/.subscription_cache
database/.subscription_state.json
database/.session_token
database/.sse_cache
database/.setup_complete
db_path.txt
machine.lock

# Local machine config: holds terminal_id/terminal_secret + LAN IPs.
# Never commit — copy config.example.json to config.json on a new machine.
config.json

# Temp/preview files
ui/temp/
*.png
!ui/**/*.png

# License & security files
.license_key
.revoked
.lockout_state
aurum_config.json
.unlock_nonce

# Code-signing material (NEVER commit — contains your cert + password)
sign_config.json
*.pfx
*.p12
*.pvk
*.spc

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.orig

# PyArmor output
.pyarmor_output/
pyarmor_runtime_000000/

# IDE files
.idea/
.vscode/
.venv/
venv/

# OS files
.DS_Store
Thumbs.db
.aider*

# Release pipeline output: GitHub Actions regenerates these on every push to
# main (see .github/workflows/release.yml), so a checked-in copy is always stale.
version.json
release_assets/
release_plan.json
release_notes.md
release_changelog.txt

# build.py stamps the highest git tag here on every build; the EXE reads it.
build_version.txt

# Generated by build.py from build_version.txt and the COMPANY/PRODUCT constants.
version_info.txt

# The dead stock report writes CSVs here at runtime. The folder itself is
# tracked, because a bill template lives in it.
exports/dead_stock_*.csv
