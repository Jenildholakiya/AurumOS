# ── AurumOS .gitignore ──────────────────────────────────────────

# Logs (runtime output)
logs/
*.log

# PyInstaller build output
build/
database/aurum_local.db
db_path.txt
machine.lock

# Temp/preview files
ui/temp/
*.png
!ui/**/*.png

# License & security files
.license_key
.revoked
.lockout_state
aurum_config.json
.unlock_nonce

# Code-signing material (NEVER commit — contains your cert + password)
sign_config.json
*.pfx
*.p12
*.pvk
*.spc

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.orig

# PyArmor output
.pyarmor_output/
pyarmor_runtime_000000/

# IDE files
.idea/
.vscode/
.venv/
venv/

# OS files
.DS_Store
Thumbs.db
.aider*
