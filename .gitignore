# ── AurumOS .gitignore ──────────────────────────────────────────

# Logs (runtime output)
logs/
*.log

# PyInstaller build output
build/
# AurumOS.spec is written from scratch by build.py on every run, and the paths
# inside it belong to whichever machine last built. Tracking it meant the
# committed copy pointed at a drive that does not exist here, and every build
# left a change that blocked the next merge.
AurumOS.spec
database/aurum_local.db
db_path.txt
machine.lock

# Temp/preview files
ui/temp/
*.png
!ui/**/*.png

# License & security files
.license_key
.revoked
.lockout_state
aurum_config.json
.unlock_nonce

# Code-signing material (NEVER commit — contains your cert + password)
sign_config.json
*.pfx
*.p12
*.pvk
*.spc

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.orig

# PyArmor output
.pyarmor_output/
pyarmor_runtime_000000/

# IDE files
.idea/
.vscode/
.venv/
venv/

# OS files
.DS_Store
Thumbs.db
.aider*

# Release pipeline output: GitHub Actions regenerates these on every push to
# main (see .github/workflows/release.yml), so a checked-in copy is always stale.
version.json
release_assets/
release_plan.json
release_notes.md
release_changelog.txt

# build.py stamps the highest git tag here on every build; the EXE reads it.
build_version.txt
